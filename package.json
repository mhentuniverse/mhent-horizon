{
  "name": "mhent-horizon",
  "version": "1.0.0",
  "description": "AISA Horizon — AI-First IDE Studio (MHEnt Universe)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "aisa",
    "horizon",
    "ide",
    "editor",
    "ai-first",
    "agent",
    "mhent-universe"
  ],
  "author": "Yorutsuki Yurika (Miyazaki Haruto Entertainment Co., Ltd.)",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mhentuniverse.aisa.horizon",
    "productName": "AISA Horizon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/horizon-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AISA Horizon"
    }
  }
}
